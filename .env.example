# Chave de API da NVIDIA NIM (obtenha em https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Base URL da API NVIDIA NIM (padrão oficial)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Limite de requisições por minuto (padrão da conta free é 40 RPM)
NVIDIA_RATE_LIMIT_RPM=40

# Modelo padrão para consultas gerais
NVIDIA_DEFAULT_MODEL=mistralai/mistral-large-4-1t-a52b

# Proteção de Quota & Telemetria
# Habilita ou desabilita probes sintéticos de saúde (true/false)
NVIDIA_HEALTHCHECK_ENABLED=true

# Piso de segurança da quota: quantidade mínima de slots RPM livres exigida
# para permitir probes sintéticos (reserva slots para trabalho real)
NVIDIA_MIN_RPM_RESERVE=15

# Tempo de vida (TTL) do cache de saúde em milissegundos (padrão: 600000 = 10 minutos)
NVIDIA_HEALTHCHECK_CACHE_TTL_MS=600000
